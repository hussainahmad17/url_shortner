<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>URL Shortener</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f4f9;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px 15px;
      color: #333;
    }

    h1 {
      color: #2c3e50;
      margin-bottom: 20px;
      text-align: center;
    }

    form {
      background: #fff;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
      margin-bottom: 30px;
      max-width: 600px;
      width: 100%;
    }

    input[type="text"] {
      padding: 10px;
      flex: 1 1 250px;
      border: 1px solid #ccc;
      border-radius: 5px;
      font-size: 16px;
      width: 100%;
    }

    button {
      background-color: #3498db;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
      flex-shrink: 0;
    }

    button:hover {
      background-color: #2980b9;
    }

    p {
      font-size: 16px;
      color: green;
      text-align: center;
      max-width: 100%;
    }

    p a {
      color: #2c3e50;
      text-decoration: none;
      font-weight: bold;
      word-break: break-all;
    }

    p a:hover {
      text-decoration: underline;
    }

    .table-container {
      overflow-x: auto;
      width: 100%;
      max-width: 1000px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background-color: #fff;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      margin-top: 20px;
      min-width: 600px;
    }

    th, td {
      padding: 12px 15px;
      border: 1px solid #ddd;
      text-align: center;
    }

    th {
      background-color: #3498db;
      color: white;
    }

    tr:nth-child(even) {
      background-color: #f9f9f9;
    }

    @media (max-width: 600px) {
      input[type="text"] {
        flex: 1 1 100%;
      }

      button {
        width: 100%;
      }

      th, td {
        font-size: 14px;
        padding: 8px;
      }
    }
  </style>
</head>
<body>
  <h1>URL Shortener</h1>

  <% if (locals.id) { %>
    <p>Generated URL: <a href="http://localhost:7000/<%= id %>" target="_blank">http://localhost:7000/<%= id %></a></p>
  <% } %>

  <form action="/url" method="POST">
    <input type="text" name="redirectUrl" placeholder="Enter URL to shorten" required />
    <button type="submit">Shorten</button>
  </form>

  <% if (locals.urls && locals.urls.length > 0) { %>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Sr. No.</th>
            <th>Short URL</th>
            <th>Redirect URL</th>
            <th>Clicks</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach((url, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><a href="http://localhost:7000/<%= url.shortID %>" target="_blank"><%= url.shortID %></a></td>
              <td><%= url.redirectUrl %></td>
              <td><%= url.visitHistory.length %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</body>
</html>
